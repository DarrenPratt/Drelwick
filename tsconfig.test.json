{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "vitest.config.ts",
    "packages/*/vitest.config.ts",
    "apps/*/vitest.config.ts",
    "tests/workspace-smoke/vitest.config.ts",
    "packages/*/test/**/*.ts",
    "apps/*/test/**/*.ts",
    "apps/*/src/renderer/window.d.ts",
    "tests/workspace-smoke/test/**/*.ts"
  ]
}
