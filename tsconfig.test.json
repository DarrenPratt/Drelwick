{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "vitest.config.ts",
    "packages/*/vitest.config.ts",
    "apps/*/vitest.config.ts",
