{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "drelwick-theme"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "theme": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,2})\\.(0|[1-9][0-9]{0,2})\\.(0|[1-9][0-9]{0,2})$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\p{Cc}<>\\uD800-\\uDFFF]*$"
        },
        "creator": {
          "type": "string",
          "maxLength": 160,
          "pattern": "^[^\\p{Cc}<>\\uD800-\\uDFFF]*$"
        },
        "description": {
          "type": "string",
          "maxLength": 1000,
          "pattern": "^[^\\p{Cc}<>\\uD800-\\uDFFF]*$"
        },
        "rights": {
          "type": "string",
          "enum": ["author-declared", "unverified"]
        }
      },
      "required": ["id", "version", "name", "creator", "description", "rights"],
      "additionalProperties": false
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "renderer": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 2,
              "maximum": 999
            },
            "maxExclusive": {
              "type": "integer",
              "minimum": 3,
              "maximum": 1000
            }
          },
          "required": ["min", "maxExclusive"],
          "additionalProperties": false
        },
        "presentation": {
          "type": "number",
          "const": 2
        },
        "print": {
          "type": "number",
          "const": 3
        },
        "requires": {
          "minItems": 1,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["style-v2", "ornament-raster-v1", "font-static-sfnt-v1"]
          }
        }
      },
      "required": ["renderer", "presentation", "print", "requires"],
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 2
        },
        "base": {
          "type": "object",
          "properties": {
            "body": {
              "$ref": "#/$defs/__schema0"
            },
            "headings": {
              "$ref": "#/$defs/__schema2"
            },
            "chapterOpening": {
              "$ref": "#/$defs/__schema4"
            },
            "sceneBreak": {
              "$ref": "#/$defs/__schema6"
            },
            "quote": {
              "$ref": "#/$defs/__schema10"
            },
            "epigraph": {
              "$ref": "#/$defs/__schema11"
            }
          },
          "required": [
            "body",
            "headings",
            "chapterOpening",
            "sceneBreak",
            "quote",
            "epigraph"
          ],
          "additionalProperties": false
        },
        "epub": {
          "type": "object",
          "properties": {
            "body": {
              "$ref": "#/$defs/__schema0"
            },
            "headings": {
              "$ref": "#/$defs/__schema2"
            },
            "chapterOpening": {
              "$ref": "#/$defs/__schema4"
            },
            "sceneBreak": {
              "$ref": "#/$defs/__schema6"
            },
            "quote": {
              "$ref": "#/$defs/__schema10"
            },
            "epigraph": {
              "$ref": "#/$defs/__schema11"
            }
          },
          "additionalProperties": false
        },
        "print": {
          "type": "object",
          "properties": {
            "bodySizePt": {
              "type": "number",
              "minimum": 9,
              "maximum": 32
            },
            "overrides": {
              "type": "object",
              "properties": {
                "body": {
                  "$ref": "#/$defs/__schema0"
                },
                "headings": {
                  "$ref": "#/$defs/__schema2"
                },
                "chapterOpening": {
                  "$ref": "#/$defs/__schema4"
                },
                "sceneBreak": {
                  "$ref": "#/$defs/__schema6"
                },
                "quote": {
                  "$ref": "#/$defs/__schema10"
                },
                "epigraph": {
                  "$ref": "#/$defs/__schema11"
                }
              },
              "additionalProperties": false
            }
          },
          "required": ["bodySizePt", "overrides"],
          "additionalProperties": false
        }
      },
      "required": ["schemaVersion", "base", "epub", "print"],
      "additionalProperties": false
    },
    "fontSets": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema1"
              },
              "kind": {
                "type": "string",
                "const": "builtin"
              },
              "family": {
                "$ref": "#/$defs/__schema12"
              }
            },
            "required": ["id", "kind", "family"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema1"
              },
              "kind": {
                "type": "string",
                "const": "assets"
              },
              "faces": {
                "type": "object",
                "properties": {
                  "regular": {
                    "$ref": "#/$defs/__schema1"
                  },
                  "italic": {
                    "$ref": "#/$defs/__schema1"
                  },
                  "bold": {
                    "$ref": "#/$defs/__schema1"
                  },
                  "boldItalic": {
                    "$ref": "#/$defs/__schema1"
                  }
                },
                "required": ["regular", "italic", "bold", "boldItalic"],
                "additionalProperties": false
              },
              "fallback": {
                "$ref": "#/$defs/__schema12"
              }
            },
            "required": ["id", "kind", "faces", "fallback"],
            "additionalProperties": false
          }
        ]
      }
    },
    "assets": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema1"
              },
              "sha256": {
                "$ref": "#/$defs/__schema13"
              },
              "licenseId": {
                "$ref": "#/$defs/__schema1"
              },
              "kind": {
                "type": "string",
                "const": "font"
              },
              "path": {
                "type": "string",
                "pattern": "^assets\\/[a-z][a-z0-9-]{0,31}\\.(ttf|otf)$"
              },
              "mediaType": {
                "type": "string",
                "enum": ["font/ttf", "font/otf"]
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 8388608
              }
            },
            "required": [
              "id",
              "sha256",
              "licenseId",
              "kind",
              "path",
              "mediaType",
              "bytes"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/__schema1"
              },
              "sha256": {
                "$ref": "#/$defs/__schema13"
              },
              "licenseId": {
                "$ref": "#/$defs/__schema1"
              },
              "kind": {
                "type": "string",
                "const": "ornament"
              },
              "path": {
                "type": "string",
                "pattern": "^assets\\/[a-z][a-z0-9-]{0,31}\\.(png|jpg)$"
              },
              "mediaType": {
                "type": "string",
                "enum": ["image/png", "image/jpeg"]
              },
              "bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4194304
              }
            },
            "required": [
              "id",
              "sha256",
              "licenseId",
              "kind",
              "path",
              "mediaType",
              "bytes"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "licenses": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema1"
          },
          "path": {
            "type": "string",
            "pattern": "^licenses\\/[a-z][a-z0-9-]{0,31}\\.txt$"
          },
          "sha256": {
            "$ref": "#/$defs/__schema13"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65536
          },
          "identifier": {
            "type": "string",
            "maxLength": 80,
            "pattern": "^[^\\p{Cc}<>\\uD800-\\uDFFF]*$"
          },
          "copyright": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^[^\\p{Cc}<>\\uD800-\\uDFFF]*$"
          },
          "permissions": {
            "type": "object",
            "properties": {
              "copyToProject": {
                "type": "boolean"
              },
              "redistributePackage": {
                "type": "boolean"
              },
              "embedEpub": {
                "type": "boolean"
              },
              "embedPdf": {
                "type": "boolean"
              },
              "subsetFont": {
                "type": "boolean"
              }
            },
            "required": [
              "copyToProject",
              "redistributePackage",
              "embedEpub",
              "embedPdf",
              "subsetFont"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "path",
          "sha256",
          "bytes",
          "identifier",
          "copyright",
          "permissions"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "formatVersion",
    "schemaVersion",
    "theme",
    "compatibility",
    "style",
    "fontSets",
    "assets",
    "licenses"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "fontSet": {
          "$ref": "#/$defs/__schema1"
        },
        "sizeRem": {
          "type": "number",
          "minimum": 0.875,
          "maximum": 1.5
        },
        "lineHeight": {
          "type": "number",
          "minimum": 1.2,
          "maximum": 2.5
        },
        "alignment": {
          "type": "string",
          "enum": ["left", "justify"]
        },
        "indentEm": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "spacingEm": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "fontSet",
        "sizeRem",
        "lineHeight",
        "alignment",
        "indentEm",
        "spacingEm"
      ],
      "additionalProperties": false
    },
    "__schema1": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}$"
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "fontSet": {
          "$ref": "#/$defs/__schema1"
        },
        "weight": {
          "anyOf": [
            {
              "type": "number",
              "const": 400
            },
            {
              "type": "number",
              "const": 600
            },
            {
              "type": "number",
              "const": 700
            }
          ]
        },
        "scale": {
          "type": "array",
          "prefixItems": [
            {
              "$ref": "#/$defs/__schema3"
            },
            {
              "$ref": "#/$defs/__schema3"
            },
            {
              "$ref": "#/$defs/__schema3"
            },
            {
              "$ref": "#/$defs/__schema3"
            },
            {
              "$ref": "#/$defs/__schema3"
            },
            {
              "$ref": "#/$defs/__schema3"
            }
          ]
        },
        "spaceBeforeEm": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "spaceAfterEm": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        }
      },
      "required": [
        "fontSet",
        "weight",
        "scale",
        "spaceBeforeEm",
        "spaceAfterEm"
      ],
      "additionalProperties": false
    },
    "__schema3": {
      "type": "number",
      "minimum": 1,
      "maximum": 3
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "fontSet": {
          "$ref": "#/$defs/__schema1"
        },
        "titleSizeEm": {
          "type": "number",
          "minimum": 1.2,
          "maximum": 4
        },
        "alignment": {
          "$ref": "#/$defs/__schema5"
        },
        "spaceBeforeEm": {
          "type": "number",
          "minimum": 0,
          "maximum": 8
        },
        "spaceAfterEm": {
          "type": "number",
          "minimum": 0,
          "maximum": 6
        },
        "firstParagraph": {
          "type": "string",
          "enum": ["normal", "flush-first"]
        },
        "ornamentPosition": {
          "type": "string",
          "enum": ["above", "below"]
        },
        "ornament": {
          "$ref": "#/$defs/__schema6"
        }
      },
      "required": [
        "fontSet",
        "titleSizeEm",
        "alignment",
        "spaceBeforeEm",
        "spaceAfterEm",
        "firstParagraph",
        "ornamentPosition",
        "ornament"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "enum": ["left", "center", "right"]
    },
    "__schema6": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "variant": {
              "type": "string",
              "enum": ["none", "space", "rule", "diamond"]
            },
            "spacingEm": {
              "$ref": "#/$defs/__schema7"
            },
            "widthPercent": {
              "$ref": "#/$defs/__schema8"
            },
            "ink": {
              "$ref": "#/$defs/__schema9"
            }
          },
          "required": ["variant", "spacingEm", "widthPercent", "ink"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "variant": {
              "type": "string",
              "const": "asset"
            },
            "spacingEm": {
              "$ref": "#/$defs/__schema7"
            },
            "widthPercent": {
              "$ref": "#/$defs/__schema8"
            },
            "ink": {
              "$ref": "#/$defs/__schema9"
            },
            "assetId": {
              "$ref": "#/$defs/__schema1"
            },
            "fallback": {
              "type": "string",
              "enum": ["rule", "diamond"]
            }
          },
          "required": [
            "variant",
            "spacingEm",
            "widthPercent",
            "ink",
            "assetId",
            "fallback"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema7": {
      "type": "number",
      "minimum": 0,
      "maximum": 4
    },
    "__schema8": {
      "type": "number",
      "minimum": 10,
      "maximum": 100
    },
    "__schema9": {
      "type": "string",
      "pattern": "^#[0-9a-f]{6}$"
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "fontSet": {
          "$ref": "#/$defs/__schema1"
        },
        "indentEm": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "spacingEm": {
          "type": "number",
          "minimum": 0,
          "maximum": 3
        },
        "fontStyle": {
          "type": "string",
          "enum": ["normal", "italic"]
        }
      },
      "required": ["fontSet", "indentEm", "spacingEm", "fontStyle"],
      "additionalProperties": false
    },
    "__schema11": {
      "type": "object",
      "properties": {
        "fontSet": {
          "$ref": "#/$defs/__schema1"
        },
        "alignment": {
          "$ref": "#/$defs/__schema5"
        },
        "widthPercent": {
          "type": "number",
          "minimum": 50,
          "maximum": 100
        },
        "spacingEm": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "fontStyle": {
          "type": "string",
          "enum": ["normal", "italic"]
        },
        "attributionSizeEm": {
          "type": "number",
          "minimum": 0.75,
          "maximum": 1.25
        }
      },
      "required": [
        "fontSet",
        "alignment",
        "widthPercent",
        "spacingEm",
        "fontStyle",
        "attributionSizeEm"
      ],
      "additionalProperties": false
    },
    "__schema12": {
      "type": "string",
      "enum": ["traditional-serif", "humanist-sans", "literary-serif"]
    },
    "__schema13": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
