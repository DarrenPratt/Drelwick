{
  "name": "drelwick",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build": "pnpm -r build",
    "typecheck": "pnpm build && pnpm -r typecheck && tsc -p tsconfig.test.json",
    "test": "pnpm build && vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:watch": "pnpm build && vitest",
    "test:coverage": "pnpm build && vitest run --coverage",
    "check:workspace": "pnpm check:architecture && pnpm build && pnpm --filter @drelwick/workspace-smoke smoke",
    "check:architecture": "node --test scripts/check-community-boundary.test.mjs && node scripts/check-community-boundary.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
