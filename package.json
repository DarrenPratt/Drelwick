{
  "name": "bookeditor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm build && pnpm -r typecheck && tsc -p tsconfig.test.json",
    "test": "pnpm build && vitest run",
    "test:watch": "pnpm build && vitest",
    "test:coverage": "pnpm build && vitest run --coverage",
    "check:workspace": "pnpm build && pnpm --filter @bookeditor/workspace-smoke smoke"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
