{
  "name": "bookeditor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "check:workspace": "pnpm build && pnpm --filter @bookeditor/workspace-smoke smoke"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
