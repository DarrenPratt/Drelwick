{
  "name": "@drelwick/desktop",
  "productName": "Drelwick",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "icons:generate": "electron ../../scripts/generate-app-icons.cjs",
    "build": "tsc -p tsconfig.json && vite build --config vite.preload.config.ts && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "pnpm build && electron .",
    "dev": "pnpm build && concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.json --watch\" \"vite build --config vite.preload.config.ts --watch\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173/ electron .\""
  },
  "dependencies": {
    "@drelwick/core": "workspace:*",
    "@drelwick/project-model": "workspace:*",
    "@drelwick/renderer": "workspace:*",
    "@drelwick/shared": "workspace:*",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "dictionary-en": "4.0.0",
    "dictionary-en-gb": "3.0.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "9.2.4",
    "cross-env": "10.1.0",
    "electron": "39.1.2",
    "jsdom": "27.0.1",
    "vite": "7.3.6",
    "wait-on": "9.0.1"
  }
}
