{
  "name": "@drelwick/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manuscript-search": {
      "types": "./dist/manuscript-search.d.ts",
      "import": "./dist/manuscript-search.js"
    },
    "./autosave": {
      "types": "./dist/autosave.d.ts",
      "import": "./dist/autosave.js"
    },
    "./chapter-semantics": {
      "types": "./dist/chapter-semantics.d.ts",
      "import": "./dist/chapter-semantics.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-docx.mjs && node scripts/build-text.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@drelwick/project-model": "workspace:*",
    "@drelwick/shared": "workspace:*",
    "fflate": "0.8.3",
    "marked": "18.0.14",
    "parse5": "8.0.1",
    "sax": "1.6.1",
    "sharp": "0.35.4",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/sax": "1.2.7",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "esbuild": "0.28.2"
  }
}
